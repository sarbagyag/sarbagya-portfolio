# --- Supabase project settings ---
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: Project Settings > API > service_role secret.
# NEVER expose this to the client — server-only, used for admin user seeding
# and privileged storage/auth operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database ---
# Project Settings > Database > Connection string > URI (use the "Session"
# pooler connection on port 5432, or the direct connection for local dev).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Admin seed user (used once by `yarn db:seed`) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Revalidation webhook secret (used by /api/revalidate) ---
REVALIDATE_SECRET=choose-a-random-string
