# Copy to .env at the repo root on the server (e.g. /opt/portfolio/.env),
# fill in real values, then:
#   docker compose up -d --build
#
# Requires the `proxy` external Docker network your Traefik stack already
# created (see /opt/traefik/docker-compose.yml) — nothing to do there, it's
# just referenced by name.

# --- Domain (point a DNS A record at this server) ---
PORTFOLIO_DOMAIN=portfolio.mandalafoods.co

# --- Postgres ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=portfolio

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Auto-seeds the single admin user on first boot only (no-op after that —
# safe to leave set, or blank out once you've logged in the first time).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- CORS ---
# Comma-separated. Must be your actual deployed Vercel frontend URL(s).
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:3000

# --- MinIO (S3-compatible object storage) ---
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=media

# --- yt-dlp cookies (favorite-track processing) ---
# YouTube's bot detection blocks datacenter/VPS IPs outright ("Sign in to
# confirm you're not a bot") without a real logged-in session's cookies.
# Not a simple secret value — it's a whole cookies.txt file, bind-mounted
# by docker-compose.yml into the api container as /cookies.txt (see
# YT_DLP_COOKIES_PATH there). To generate one, on a machine with a real
# browser session (yt-dlp installed locally, e.g. `brew install yt-dlp`),
# run the single line below AS-IS in a terminal — it's plain shell, not a
# `#`-prefixed comment to strip, despite living in this commented block:
#
# yt-dlp --cookies-from-browser chrome --cookies yt-dlp-cookies.txt --skip-download "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
#
# then copy the resulting yt-dlp-cookies.txt to this repo's root on the VPS
# (gitignored — never commit it, it's a real session credential).
# Prefer a throwaway/secondary Google account over your primary one — a
# small risk of that account getting bot-flagged from repeated server-side
# use isn't zero. Session cookies also expire periodically; if downloads
# start failing again with the same "not a bot" error, regenerate the file
# the same way.
