# Copy to .env at the repo root on the server (e.g. /opt/portfolio/.env),
# fill in real values, then:
#   docker compose up -d --build
#
# Requires the `proxy` external Docker network your Traefik stack already
# created (see /opt/traefik/docker-compose.yml) — nothing to do there, it's
# just referenced by name.

# --- Domain (point a DNS A record at this server) ---
PORTFOLIO_DOMAIN=portfolio.mandalafoods.co

# --- Postgres ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=portfolio

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Auto-seeds the single admin user on first boot only (no-op after that —
# safe to leave set, or blank out once you've logged in the first time).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- CORS ---
# Comma-separated. Must be your actual deployed Vercel frontend URL(s).
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app,http://localhost:3000

# --- MinIO (S3-compatible object storage) ---
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=media
