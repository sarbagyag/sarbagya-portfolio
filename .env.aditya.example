# Copy to .env.aditya at the repo root on the server, fill in real values, then:
#   docker compose -f docker-compose.aditya.yml -p aditya-portfolio \
#     --env-file .env.aditya up -d --build
#
# Requires the `proxy` external Docker network your Traefik stack already
# created — same network the original portfolio.mandalafoods.co stack uses,
# nothing to do there, it's just referenced by name.

# --- Domain (point a DNS A record at this server) ---
PORTFOLIO_DOMAIN=timal.mandalafoods.co

# --- Postgres ---
# Use a distinct DB name/user from the original stack — they run on separate
# containers/volumes but keeping names distinct avoids confusion.
POSTGRES_USER=aditya_portfolio
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=aditya_portfolio

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Auto-seeds the single admin user on first boot only (no-op after that —
# safe to leave set, or blank out once you've logged in the first time).
ADMIN_EMAIL=aditya@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- CORS ---
# Comma-separated. Must be Aditya's actual deployed frontend URL(s).
CORS_ALLOWED_ORIGINS=https://his-site.vercel.app,http://localhost:3000

# --- MinIO (S3-compatible object storage) ---
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
# S3 bucket naming rules apply: lowercase letters, digits, and HYPHENS only
# (no underscores) — an invalid name fails at boot with "check bucket: The
# specified bucket is not valid." and crash-loops the api container. If you
# rename this, no other file needs to change: Traefik's PathPrefix(`/media`)
# is a raw prefix match, so e.g. `/media-timal/*` still routes to minio.
MINIO_BUCKET=media
